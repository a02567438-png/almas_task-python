class Shape
{
public:
    virtual void area() = 0;
};

class Circle : public Shape
{
private:
    float r;

public:
    void getData()
    {
        cout << "Enter radius: ";
        cin >> r;
    }

    void area()
    {
        cout << "Circle Area = " << 3.14 * r * r;
    }
};

class Rectangle : public Shape
{
private:
    int l, b;

public:
    void getData()
    {
        cout << "\nEnter length: ";
        cin >> l;

        cout << "Enter breadth: ";
        cin >> b;
    }

    void area()
    {
        cout << "Rectangle Area = " << l * b;
    }
};

int main()
{
    Circle c;
    Rectangle r;

    c.getData();
    c.area();

    r.getData();
    r.area();

    return 0;
}



